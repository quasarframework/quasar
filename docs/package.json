{
  "name": "quasar.dev",
  "version": "2.0.0",
  "private": true,
  "description": "Official Quasar Docs Website",
  "author": "Razvan Stoenescu <razvan.stoenescu@gmail.com>",
  "type": "module",
  "scripts": {
    "prepare:types": "quasar prepare --silent",
    "dev": "quasar dev",
    "dev:ssg": "quasar dev -m ssg",
    "dev:ssr": "quasar dev -m ssr",
    "preview": "quasar clean && quasar build -m ssr --no-summary && cp src-ssr/pnpm-workspace.yaml dist/quasar.dev/ && pnpm i --dir dist/quasar.dev && du -sh dist/quasar.dev/client && du -sh dist/quasar.dev/server && node dist/quasar.dev",
    "build": "quasar clean && node build/search.js && quasar build -m ssg --no-summary && du -sh dist/quasar.dev && du -h dist/quasar.dev/service-worker.js",
    "relnotes": "node build/release-notes/index.js"
  },
  "dependencies": {
    "@quasar/extras": "^2.0.0",
    "@shikijs/langs": "^4.3.1",
    "@shikijs/transformers": "^4.3.1",
    "quasar": "^2.21.2",
    "shiki": "^4.3.1",
    "vue": "^3.5.39",
    "vue-router": "^5.1.0"
  },
  "devDependencies": {
    "@quasar/app-vite": "^3.0.1",
    "@rolldown/pluginutils": "^1.0.1",
    "fs-extra": "^11.3.6",
    "gray-matter": "^4.0.3",
    "markdown-ast": "^0.3.0",
    "markdown-it": "^14.3.0",
    "markdown-it-container": "^4.0.0",
    "tinyglobby": "^0.2.17",
    "toml": "^4.1.2",
    "workbox-build": "^7.4.1"
  },
  "productName": "quasar-docs"
}
