{
  "name": "quasar.dev",
  "version": "2.0.0",
  "private": true,
  "description": "Official Quasar Docs Website",
  "author": "Razvan Stoenescu <razvan.stoenescu@gmail.com>",
  "type": "module",
  "scripts": {
    "prepare:types": "quasar prepare --silent",
    "generate:search": "node build/search.js",
    "generate:ai-docs": "node build/ai-docs/extract.js",
    "test": "pnpm test:unit && node test/suites.js",
    "test:unit": "vitest run",
    "test:build": "node build/ensure-fresh-build.js",
    "pretest:e2e:ssr": "node ../ui/build/ensure-fresh-build.js && playwright install chromium",
    "test:e2e:ssr": "vitest run -c vitest-e2e-ssr.config.js",
    "test:watch": "vitest",
    "dev": "node ../ui/build/ensure-fresh-build.js && quasar dev",
    "dev:ssg": "node ../ui/build/ensure-fresh-build.js && quasar dev -m ssg",
    "dev:ssr": "node ../ui/build/ensure-fresh-build.js && quasar dev -m ssr",
    "preview": "node ../ui/build/ensure-fresh-build.js && quasar clean && quasar build -m ssr --no-summary && cp src-ssr/pnpm-workspace.yaml dist/quasar.dev/ && pnpm i --dir dist/quasar.dev && du -sh dist/quasar.dev/client && du -sh dist/quasar.dev/server && node dist/quasar.dev",
    "build": "node ../ui/build/ensure-fresh-build.js && quasar clean && pnpm generate:search && quasar build -m ssg --no-summary && pnpm generate:ai-docs && cp -R build/ai-docs/dist/. dist/quasar.dev/ && rm -f dist/quasar.dev/_warnings.json && du -sh dist/quasar.dev && du -h dist/quasar.dev/service-worker.js",
    "relnotes": "node build/release-notes/index.js"
  },
  "dependencies": {
    "@quasar/extras": "^2.0.0",
    "@shikijs/langs": "^4.4.2",
    "@shikijs/transformers": "^4.4.2",
    "quasar": "^2.25.1",
    "shiki": "^4.4.2",
    "vue": "^3.5.41",
    "vue-router": "^5.2.0"
  },
  "devDependencies": {
    "@quasar/app-vite": "^3.8.0",
    "@rolldown/pluginutils": "^1.0.1",
    "@vitejs/plugin-vue": "^6.0.8",
    "fs-extra": "^11.4.0",
    "gray-matter": "^4.0.3",
    "markdown-it": "^15.0.0",
    "markdown-it-container": "^4.0.0",
    "playwright": "^1.57.0",
    "tinyglobby": "^0.2.17",
    "tokenx": "^2.1.0",
    "toml": "^5.0.0",
    "vitest": "^4.1.10",
    "workbox-build": "^7.4.1"
  },
  "productName": "quasar-docs"
}
