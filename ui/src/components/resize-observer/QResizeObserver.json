{
  "meta": {
    "docsUrl": "https://v2.quasar.dev/vue-components/resize-observer"
  },

  "props": {
    "debounce": {
      "extends": "debounce",
      "default": "100",
      "examples": ["0", "'530'"]
    }
  },

  "events": {
    "resize": {
      "desc": "Parent element has resized (width or height changed)",
      "params": {
        "size": {
          "type": "Object",
          "desc": "New size",
          "definition": {
            "height": {
              "type": "Number",
              "required": true,
              "desc": "Layout height"
            },
            "width": {
              "type": "Number",
              "required": true,
              "desc": "Layout width"
            }
          }
        }
      }
    }
  },

  "methods": {
    "trigger": {
      "desc": "Emit a 'resize' event",
      "params": {
        "immediately": {
          "type": "Boolean",
          "desc": "Skip over the debounce amount"
        }
      },
      "returns": null
    }
  }
}
