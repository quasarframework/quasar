{
  "meta": {
    "docsUrl": "https://v2.quasar.dev/quasar-plugins/web-storage"
  },

  "props": {
    "items": {
      "type": "Object",
      "addedIn": "v2.34",
      "reactive": true,
      "desc": "A reactive view of the storage, one property per key: reading a property gives the item value (null while missing), assigning one persists it (as setItem() does) and deleting it removes it; a nested change of an object or Array value gets persisted too. It follows the changes made through the other methods and those made from another tab/window of the same origin. It is not enumerable and has no 'in' (see getAllKeys(), getAll() and hasItem()). A key read from a component (or any effect scope) is tracked while that scope lives; a key first read outside of one, for the rest of the page",
      "examples": ["{ theme: 'dark', settings: { notifications: true } }"]
    }
  },

  "methods": {
    "hasItem": {
      "desc": "Check if storage item exists",
      "alias": "has",
      "params": {
        "key": {
          "type": "String",
          "desc": "Entry key",
          "required": true,
          "examples": ["'userId'"]
        }
      },
      "returns": {
        "type": "Boolean",
        "desc": "Does the item exist or not?"
      }
    },

    "getLength": {
      "desc": "Get storage number of entries",
      "params": null,
      "returns": {
        "type": "Number",
        "desc": "Number of entries"
      }
    },

    "getItem": {
      "tsType": "WebStorageGetItemMethodType",
      "desc": "Get a storage item value",
      "params": {
        "key": {
          "type": "String",
          "desc": "Entry key",
          "required": true,
          "examples": ["'userId'"]
        }
      },
      "returns": {
        "type": [
          "Number",
          "Boolean",
          "Date",
          "RegExp",
          "Object",
          "Array",
          "String",
          "null"
        ],
        "desc": "Storage item value; null for a missing item",
        "examples": ["'john12'", "702"]
      }
    },

    "getIndex": {
      "tsType": "WebStorageGetIndexMethodType",
      "desc": "Get the storage item value at specific index",
      "params": {
        "index": {
          "type": "Number",
          "desc": "Entry index",
          "required": true
        }
      },
      "returns": {
        "type": [
          "Number",
          "Boolean",
          "Date",
          "RegExp",
          "Object",
          "Array",
          "String",
          "null"
        ],
        "desc": "Storage item value at that index; null past the end"
      }
    },

    "getKey": {
      "tsType": "WebStorageGetKeyMethodType",
      "desc": "Get the storage key at specific index",
      "params": {
        "index": {
          "type": "Number",
          "desc": "Entry index",
          "required": true
        }
      },
      "returns": {
        "type": ["String", "null"],
        "desc": "Storage key; null past the end",
        "examples": ["'userId'"]
      }
    },

    "getAll": {
      "desc": "Retrieve all items in storage",
      "params": null,
      "returns": {
        "type": "Object",
        "desc": "Object syntax: item name as Object key and its value",
        "examples": ["{ userId: 'rstoenescu', timesLoggedIn: 14 }"]
      }
    },

    "getAllKeys": {
      "tsType": "WebStorageGetAllKeysMethodType",
      "desc": "Retrieve all keys in storage",
      "params": null,
      "returns": {
        "type": "Array",
        "desc": "Storage keys (Array of Strings)",
        "examples": ["['userId', 'password']"]
      }
    },

    "setItem": {
      "desc": "Set item in storage",
      "alias": "set",
      "params": {
        "key": {
          "type": "String",
          "desc": "Entry key",
          "required": true,
          "examples": ["'userId'"]
        },

        "value": {
          "type": [
            "Number",
            "Boolean",
            "Date",
            "RegExp",
            "Function",
            "Object",
            "Array",
            "String",
            "null"
          ],
          "desc": "Entry value; a Function is stored as its source and null/undefined as the Strings the browser makes of them (use removeItem() to remove an item)",
          "required": true,
          "params": {
            "...params": {
              "type": "Any",
              "__exemption": ["desc"]
            }
          },
          "returns": {
            "type": "Any",
            "__exemption": ["desc"]
          },
          "examples": ["'john12'"]
        }
      },
      "returns": null
    },

    "removeItem": {
      "desc": "Remove a storage item",
      "alias": "remove",
      "params": {
        "key": {
          "type": "String",
          "desc": "Storage key",
          "required": true,
          "examples": ["'userId'"]
        }
      },
      "returns": null
    },

    "clear": {
      "desc": "Remove everything from the storage",
      "params": null,
      "returns": null
    },

    "isEmpty": {
      "desc": "Determine if storage has any items",
      "params": null,
      "returns": {
        "type": "Boolean",
        "desc": "Tells if storage is empty or not"
      }
    }
  }
}
