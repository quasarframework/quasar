  {
    "id": "vue-components/no-ssr#overview",
    "documentId": "vue-components/no-ssr",
    "heading": "No SSR",
    "breadcrumb": [
      "No SSR"
    ],
    "level": 1,
    "canonicalUrl": "https://quasar.dev/vue-components/no-ssr",
    "content": "The QNoSsr component makes sense only if you are creating a SSR website/app.\n\nIt avoids rendering its content on the server and leaves that for client only. Useful when you got code that is not isomorphic and can only run on the client side, in a browser.\n\nAlternatively, you can also use it to render content only on server-side and it automatically removes it if it ends up running on a client browser.\n\nAPI reference: QNoSsr",
    "apiReferences": [
      "QNoSsr"
    ],
    "exampleReferences": []
  },
