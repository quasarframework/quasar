    "id": "vue-components/floating-action-button#overview",
    "documentId": "vue-components/floating-action-button",
    "heading": "Floating Action Button",
    "breadcrumb": [
      "Floating Action Button"
    ],
    "level": 1,
    "canonicalUrl": "https://quasar.dev/vue-components/floating-action-button",
    "content": "A Floating Action Button (FAB) represents the primary action in a Page. But, it's not limited to only a single action. It can contain any number of sub-actions too. And more importantly, it can also be used inline in your Pages or Layouts.\n\nNote that you don’t need a QLayout to use FABs.\n\nAPI reference: QFab\n\nAPI reference: QFabAction",
    "apiReferences": [
      "QFab",
      "QFabAction"
    ],
    "exampleReferences": []
  },
