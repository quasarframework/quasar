  {
    "id": "vue-components/slider#overview",
    "documentId": "vue-components/slider",
    "heading": "Slider",
    "breadcrumb": [
      "Slider"
    ],
    "level": 1,
    "canonicalUrl": "https://quasar.dev/vue-components/slider",
    "content": "The QSlider is a great way for the user to specify a number value between a minimum and maximum value, with optional steps between valid values. The slider also has a focus indicator (highlighted slider button), which allows for keyboard adjustments of the slider.\n\nAlso check its “sibling”, the [QRange](/vue-components/range) component.\n\nAPI reference: QSlider",
    "apiReferences": [
      "QSlider"
    ],
    "exampleReferences": []
  },
