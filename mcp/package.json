{
  "name": "@quasar/mcp",
  "version": "0.1.0",
  "description": "Official read-only MCP server for Quasar documentation",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "quasar",
    "vue"
  ],
  "homepage": "https://quasar.dev",
  "bugs": "https://github.com/quasarframework/quasar/issues",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/quasarframework/quasar.git",
    "directory": "mcp"
  },
  "bin": {
    "quasar-mcp": "bin/quasar-mcp.js"
  },
  "files": [
    "bin",
    "src",
    "generated",
    "README.md"
  ],
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "generate": "node scripts/generate.js",
    "evaluate": "node scripts/evaluate.js",
    "validate": "node scripts/validate.js",
    "test": "node --test tests/*.test.js",
    "test:immutability": "node scripts/verify-immutability.js",
    "test:server": "node --test tests/server.test.js",
    "prepack": "pnpm validate && pnpm evaluate && pnpm test",
    "start": "node bin/quasar-mcp.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.29.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "yaml": "2.9.0"
  },
  "engines": {
    "node": ">=22"
  }
}
