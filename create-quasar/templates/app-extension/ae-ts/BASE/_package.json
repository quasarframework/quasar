{
  "name": "quasar-app-extension-<%= scope.name %>-monorepo",
  "private": true,
  <% if (scope.packageManagerField) { %>"packageManager": "<%= scope.packageManagerField %>",<% } %>
  "author": "<%= scope.author %>",
  "type": "module",
  <% if (scope.packageManager?.name !== 'pnpm') { %>"workspaces": [
    "app-extension",
    "playground"
  ],<% } %>
  "scripts": {
    <% if (scope.packageManager) { %>
    "dev": <% if (['pnpm', 'bun'].includes(scope.packageManager.name)) { %>"<%= scope.packageManager.name %> --filter ./playground dev"<% } else if (scope.packageManager.name === 'yarn') { %>"yarn workspace playground dev"<% } else { %>"npm run --workspace playground dev"<% } %>,
    <% } else { %>
    "dev": "pnpm --filter ./playground dev",
    <% } %>
    "lint": "oxfmt && oxlint --fix",
    "lint:check": "oxfmt --check && oxlint"
  },
  "devDependencies": {
    "@types/node": "^22.19.11",
    "oxfmt": "^0.x",
    "oxlint": "^1.64.0",
    "oxlint-tsgolint": "^0.22.1",
    "typescript": "^5.5.4"
  },
  "engines": {
    "node": "^26 || ^24 || ^22.12"
  }
}
