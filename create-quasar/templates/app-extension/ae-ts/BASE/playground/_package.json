{
  "name": "playground",
  "version": "0.0.1",
  "description": "Playground for Quasar AE <%= scope.name %>",
  "productName": "Quasar AE <%= scope.name %> Playground",
  "author": "<%= scope.author %>",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "quasar dev",
    "build": "quasar build"
  },
  "dependencies": {
    "@quasar/extras": "^1.16.12",
    "quasar": "^2.16.7",
    "vue": "^3.4.36",
    "vue-router": "^5.0.3",
    "<%= scope.pkgName %>": <% if (!scope.packageManager || ['pnpm', 'bun'].includes(scope.packageManager.name)) { %>"workspace:*"<% } else { %>"*"<% } %>
  },
  "devDependencies": {
    "@quasar/app-vite": "^3.0.0-beta.8",
    "@types/node": "^22.19.11",
    "autoprefixer": "^10.4.20"
  },
  "engines": {
    "node": "^26 || ^24 || ^22.12"
  }
}
