{
  "name": "<%= scope.pkgName %>",
  "version": "0.0.1",
  "description": "<%= scope.description %>",
  "author": "<%= scope.author %>",
  "license": "MIT",
  "type": "module",
  "files": ["src", "README.md"],
  "exports": {
    ".": "./src/runtime/index.ts",
    "./package.json": "./package.json",
    "./index": "./src/index.ts",
    <% if (scope.preset.prompts) { %>"./prompts": "./src/prompts.ts",<% } %>
    <% if (scope.preset.install) { %>"./install": "./src/install.ts",<% } %>
    <% if (scope.preset.uninstall) { %>"./uninstall": "./src/uninstall.ts",<% } %>
    "./*": "./src/runtime/*"
  },
  "devDependencies": {
    "@quasar/app-vite": "^3.0.0-beta.8",
    "quasar": "^2.16.7",
    "vue": "^3.4.36"
  },
  "peerDependencies": {
    "@quasar/app-vite": "^3.0.0-0",
    "quasar": "^2.16.0",
    "vue": "^3.4.0"
  }
}
